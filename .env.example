NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://fiap:fiap@localhost:5432/fiap_videos_api
REDIS_URL=redis://localhost:6380

RABBITMQ_URL=amqp://fiap:fiap@localhost:5673/
VIDEO_EVENTS_EXCHANGE=fiap-videos.events
VIDEO_EVENTS_DLX=fiap-videos.events.dlx
RABBITMQ_CONNECTION_NAME=api

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Object storage — local: MinIO (start via app-fiap-videos-infra/docker compose)
STORAGE_BACKEND=minio
S3_BUCKET=fiap-videos
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Production (Kubernetes): STORAGE_BACKEND=s3, S3_BUCKET, AWS_REGION=sa-east-1 (IRSA credentials)
MAX_UPLOAD_BYTES=104857600

SEED_ADMIN_EMAIL=admin@fiap-videos.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_EMAIL=demo@fiap-videos.local
SEED_USER_PASSWORD=Demo12345

# Create admin (and demo user in non-production) on startup when true
BOOTSTRAP_USERS=false

# Production security (optional locally)
# NODE_ENV=production
# TRUST_PROXY=true
# CORS_ORIGINS=https://api.example.com
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

OUTBOX_MAX_ATTEMPTS=10

# Logging: pretty (local dev) or json (production / log collectors)
LOG_FORMAT=pretty
# LOG_LEVEL=info
