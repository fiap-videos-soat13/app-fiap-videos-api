NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://fiap:fiap@localhost:5433/fiap_videos_api
REDIS_URL=redis://localhost:6380

RABBITMQ_URL=amqp://fiap:fiap@localhost:5673/
VIDEO_EVENTS_EXCHANGE=fiap-videos.events
VIDEO_EVENTS_DLX=fiap-videos.events.dlx
RABBITMQ_CONNECTION_NAME=api

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=104857600

SEED_ADMIN_EMAIL=admin@fiap-videos.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_EMAIL=demo@fiap-videos.local
SEED_USER_PASSWORD=Demo12345

# Production security (optional locally)
# NODE_ENV=production
# TRUST_PROXY=true
# CORS_ORIGINS=https://api.example.com
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

OUTBOX_MAX_ATTEMPTS=10
